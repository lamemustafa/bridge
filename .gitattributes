* text=auto eol=lf

*.icns binary
*.ico binary
*.png binary

# Test fixtures are byte-exact evidence. Their retained byte length and
# SHA-256 may be asserted in tests, so line-ending normalisation would silently
# rewrite the evidence and make those assertions machine-dependent.
src-tauri/crates/bridge-tally-protocol/tests/fixtures/** -text
src-tauri/crates/tally-protocol-simulator/fixtures/** -text
docs/tally/compatibility/fixtures/** -text
scripts/fixtures/** -text

# Concurrent PRs that each touch a DIFFERENT already-pinned file both edit the
# same two derived lines (manifest_sha256 / compatibility_surface_sha256),
# which git's default line-based merge always reports as conflicting even
# though the actual pin lists merge cleanly underneath them. This driver
# reconciles the pin lists itself and reseals -- see scripts/reseal-merge-driver.mjs
# for exactly what it will and will not auto-resolve, and see
# docs/release-process.md ("Merge driver (local only)") for the one-time
# `git config` line this needs and, importantly, why it does NOT change what
# GitHub's server-side PR merge reports.
docs/tally/compatibility/compatibility-surface.json merge=bridge-compat-reseal
docs/tally/compatibility/compatibility-matrix.json merge=bridge-compat-reseal
